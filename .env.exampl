# Образец .env: скопировать в .env и заполнить. Настоящие ключи сюда не писать (файл в git).
TELEGRAM_BOT_TOKEN=123456789:replace-me
# chat_id админов через запятую: одобряют пользователей, получают уведомления об ошибках
ADMIN_CHAT_IDS=

# Провайдер LLM: claude, groq или omniroute; ключ нужен только выбранному
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# OmniRoute: ключ создаётся в панели шлюза (http://localhost:20128, API Keys), модель или комбо из его каталога
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

DATABASE_URL=postgresql+asyncpg://coach:replace-me@localhost:5432/coach_db
GARMIN_TOKENS_DIR=.garmin_tokens

# Docker compose: пароль БД в контейнере (DATABASE_URL compose подставит сам)
POSTGRES_PASSWORD=replace-me
